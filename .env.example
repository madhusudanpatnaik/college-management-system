# ─── College Management System — Environment Variables ───
#
# Copy this file to .env and fill in production values.
# In development, defaults are used for all optional variables.

# ─── Required in production ───────────────────────────────

# Secret key for signing JWT tokens. MUST be set in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── Server ───────────────────────────────────────────────

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Set to "production" for production deployments.
# Controls: seed data, demo UI, HSTS, CORS strictness, error verbosity.
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────

# Comma-separated list of allowed origins for cross-origin requests.
# Only needed when the frontend is hosted on a different origin.
# In production with no value set, cross-origin requests are blocked.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ─── Email (future — password resets, notifications) ──────

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@college.edu
