# Reference list of environment variables. There is no dotenv dependency, so
# this file is documentation — export these in your shell, service unit, or
# process manager before starting the server. For local development:
#
#   set -a && source .env && set +a && npm start
#
# JWT_SECRET is REQUIRED and has no default. The server throws at startup if it
# is unset, because a known signing secret lets anyone forge a token for any
# user and any role.

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional — sensible non-sensitive defaults apply if unset.
JWT_EXPIRES_IN=8h
PORT=3000
